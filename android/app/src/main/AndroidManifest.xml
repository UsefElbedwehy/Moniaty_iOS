<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MunyatiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Munyati">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links on munyati.co (needs website/.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="munyati.co" />
                <data android:host="www.munyati.co" />
                <data android:pathPrefix="/p/" />
                <data android:pathPrefix="/s/" />
                <data android:pathPrefix="/store/" />
                <data android:pathPrefix="/c/" />
                <data android:pathPrefix="/b/" />
                <data android:path="/plans" />
                <data android:path="/notifications" />
            </intent-filter>

            <!-- munyati://p/<id> and friends. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="munyati" />
            </intent-filter>
        </activity>
    </application>
</manifest>
