{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/terms", "destination": "/legal" },
    { "source": "/privacy", "destination": "/legal" },
    { "source": "/about", "destination": "/legal" },
    { "source": "/faq", "destination": "/legal" },
    { "source": "/provider-terms", "destination": "/legal" },
    { "source": "/en/:slug(terms|privacy|about|faq|provider-terms)", "destination": "/legal" },
    { "source": "/:kind(p|s|store|c|b)/:id", "destination": "/open" },
    { "source": "/plans", "destination": "/open" }
  ],
  "headers": [
    { "source": "/.well-known/apple-app-site-association", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
