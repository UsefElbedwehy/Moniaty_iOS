# Supabase project URL and the PUBLIC anon key only.
# Never put the service-role key here: every admin action runs with the admin's own session
# and is checked in Postgres (admin_users + permissions).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
